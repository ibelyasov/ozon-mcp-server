{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ozon_get_images success output",
  "type": "object",
  "required": [
    "schemaVersion",
    "researchId",
    "data",
    "context",
    "observedAt",
    "evidence",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "3"
    },
    "researchId": {
      "$ref": "common.schema.json#/$defs/opaque"
    },
    "data": {
      "type": "object",
      "required": [
        "results"
      ],
      "properties": {
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/result"
          }
        }
      },
      "additionalProperties": false
    },
    "context": {
      "$ref": "common.schema.json#/$defs/context"
    },
    "observedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "evidence": {
      "type": "array",
      "maxItems": 0
    },
    "warnings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "common.schema.json#/$defs/warning"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "imageOk": {
      "type": "object",
      "required": [
        "imageRef",
        "status",
        "sourceKind",
        "sourceRef",
        "evidenceRefs",
        "mimeType",
        "width",
        "height",
        "sha256",
        "retrievedAt",
        "contentIndex"
      ],
      "properties": {
        "imageRef": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "status": {
          "const": "ok"
        },
        "sourceKind": {
          "enum": [
            "product",
            "review"
          ]
        },
        "sourceRef": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "evidenceRefs": {
          "$ref": "common.schema.json#/$defs/evidenceRefs"
        },
        "mimeType": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "retrievedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "contentIndex": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "imageErrorValue": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "enum": [
            "INVALID_REFERENCE",
            "CONTEXT_CHANGED",
            "RESEARCH_EXPIRED",
            "SOURCE_BLOCKED",
            "SOURCE_CHANGED",
            "UPSTREAM_TIMEOUT",
            "NOT_FOUND",
            "RESULT_TOO_LARGE",
            "SERVER_BUSY"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "imageError": {
      "type": "object",
      "required": [
        "imageRef",
        "status",
        "error"
      ],
      "properties": {
        "imageRef": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "status": {
          "const": "error"
        },
        "error": {
          "$ref": "#/$defs/imageErrorValue"
        }
      },
      "additionalProperties": false
    },
    "result": {
      "oneOf": [
        {
          "$ref": "#/$defs/imageOk"
        },
        {
          "$ref": "#/$defs/imageError"
        }
      ]
    }
  }
}
