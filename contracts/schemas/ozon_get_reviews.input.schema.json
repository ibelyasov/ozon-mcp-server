{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ozon_get_reviews input",
  "type": "object",
  "required": [
    "start"
  ],
  "properties": {
    "start": {
      "oneOf": [
        {
          "$ref": "#/$defs/productStart"
        },
        {
          "$ref": "#/$defs/referenceStart"
        },
        {
          "$ref": "common.schema.json#/$defs/cursorStart"
        }
      ]
    },
    "researchId": {
      "$ref": "common.schema.json#/$defs/opaque"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30,
      "default": 10
    },
    "includeFacets": {
      "type": "boolean",
      "description": "Request bounded review refinements explicitly.",
      "default": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "productStart": {
      "type": "object",
      "required": [
        "productRef"
      ],
      "properties": {
        "productRef": {
          "$ref": "common.schema.json#/$defs/opaque"
        }
      },
      "additionalProperties": false
    },
    "referenceStart": {
      "type": "object",
      "required": [
        "reviewSearchRef"
      ],
      "properties": {
        "reviewSearchRef": {
          "$ref": "common.schema.json#/$defs/opaque"
        }
      },
      "additionalProperties": false
    }
  }
}
