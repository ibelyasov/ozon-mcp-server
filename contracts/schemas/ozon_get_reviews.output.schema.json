{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ozon_get_reviews success output",
  "type": "object",
  "required": [
    "schemaVersion",
    "researchId",
    "data",
    "context",
    "observedAt",
    "evidence",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "3"
    },
    "researchId": {
      "$ref": "common.schema.json#/$defs/opaque"
    },
    "data": {
      "type": "object",
      "required": [
        "subjectSku",
        "aggregationScope",
        "aggregate",
        "reviews",
        "refinements",
        "refinementsIncluded",
        "refinementsTruncated",
        "coverage",
        "nextCursor",
        "hasNext"
      ],
      "properties": {
        "subjectSku": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 64
        },
        "aggregationScope": {
          "enum": [
            "specific_sku",
            "multiple_variants",
            "unknown"
          ]
        },
        "aggregate": {
          "type": "object",
          "required": [
            "rating",
            "count"
          ],
          "properties": {
            "rating": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 5
            },
            "count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "reviews": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/review"
          }
        },
        "refinements": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/refinement"
          }
        },
        "refinementsIncluded": {
          "type": "boolean"
        },
        "refinementsTruncated": {
          "type": "boolean"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "nextCursor": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/opaque"
            },
            {
              "type": "null"
            }
          ]
        },
        "hasNext": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "context": {
      "$ref": "common.schema.json#/$defs/context"
    },
    "observedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "evidence": {
      "type": "array",
      "maxItems": 0
    },
    "warnings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "common.schema.json#/$defs/warning"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "review": {
      "type": "object",
      "required": [
        "reviewRef",
        "rating",
        "publishedAt",
        "text",
        "variantLabel",
        "purchaseVerified",
        "evidenceRefs"
      ],
      "properties": {
        "reviewRef": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "rating": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "publishedAt": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 12000
        },
        "variantLabel": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "purchaseVerified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "imageRefs": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/opaque"
          }
        },
        "evidenceRefs": {
          "$ref": "common.schema.json#/$defs/evidenceRefs"
        }
      },
      "additionalProperties": false
    },
    "refinement": {
      "type": "object",
      "required": [
        "kind",
        "label",
        "groupLabel",
        "selected",
        "reviewSearchRef"
      ],
      "properties": {
        "kind": {
          "enum": [
            "filter",
            "sort"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "groupLabel": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "selected": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reviewSearchRef": {
          "$ref": "common.schema.json#/$defs/opaque"
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "returned",
        "uniqueSeen",
        "total",
        "snapshotGuaranteed",
        "completeness"
      ],
      "properties": {
        "returned": {
          "type": "integer",
          "minimum": 0
        },
        "uniqueSeen": {
          "type": "integer",
          "minimum": 0,
          "description": "Distinct review identities (stable source IDs are deduplicated; ID-less rows remain distinct) returned across this cursor chain, including the current response; replaying a cursor is stable and a fresh query/refinement starts a new chain."
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "snapshotGuaranteed": {
          "const": false
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
