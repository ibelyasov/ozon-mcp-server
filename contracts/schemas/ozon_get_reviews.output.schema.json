{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ozon_get_reviews success output",
  "type": "object",
  "required": ["schemaVersion", "researchId", "data", "context", "observedAt", "evidence", "warnings"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "researchId": {"$ref": "#/$defs/opaque"},
    "data": {
      "type": "object",
      "required": ["subjectSku", "aggregationScope", "aggregate", "reviews", "refinements", "refinementsIncluded", "refinementsTruncated", "coverage", "nextCursor", "hasNext"],
      "properties": {
        "subjectSku": {"type": "string", "pattern": "^[0-9]+$", "maxLength": 64},
        "aggregationScope": {"enum": ["specific_sku", "multiple_variants", "unknown"]},
        "aggregate": {"type": "object", "required": ["rating", "count"], "properties": {"rating": {"type": ["number", "null"], "minimum": 0, "maximum": 5}, "count": {"type": ["integer", "null"], "minimum": 0}}, "additionalProperties": false},
        "reviews": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/review"}},
        "refinements": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/refinement"}},
        "refinementsIncluded": {"type": "boolean"},
        "refinementsTruncated": {"type": "boolean"},
        "coverage": {"$ref": "#/$defs/coverage"},
        "nextCursor": {"oneOf": [{"$ref": "#/$defs/opaque"}, {"type": "null"}]},
        "hasNext": {"type": ["boolean", "null"]}
      },
      "additionalProperties": false
    },
    "context": {"$ref": "#/$defs/context"},
    "observedAt": {"$ref": "#/$defs/timestamp"},
    "evidence": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/evidence"}},
    "warnings": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/warning"}}
  },
  "additionalProperties": false,
  "$defs": {
    "opaque": {"type": "string", "minLength": 1, "maxLength": 2048},
    "timestamp": {"type": "string", "format": "date-time"},
    "evidenceRefs": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/opaque"}},
    "review": {"type": "object", "required": ["reviewRef", "rating", "publishedAt", "text", "variantLabel", "purchaseVerified", "imageRefs", "evidenceRefs"], "properties": {"reviewRef": {"$ref": "#/$defs/opaque"}, "rating": {"type": ["integer", "null"], "minimum": 1, "maximum": 5}, "publishedAt": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}, "text": {"type": ["string", "null"], "maxLength": 12000}, "variantLabel": {"type": ["string", "null"], "maxLength": 1000}, "purchaseVerified": {"type": ["boolean", "null"]}, "imageRefs": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"$ref": "#/$defs/opaque"}}, "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}}, "additionalProperties": false},
    "refinement": {"type": "object", "required": ["kind", "label", "groupLabel", "selected", "reviewSearchRef"], "properties": {"kind": {"enum": ["filter", "sort"]}, "label": {"type": "string", "minLength": 1, "maxLength": 500}, "groupLabel": {"type": ["string", "null"], "maxLength": 500}, "selected": {"type": ["boolean", "null"]}, "reviewSearchRef": {"$ref": "#/$defs/opaque"}}, "additionalProperties": false},
    "coverage": {"type": "object", "required": ["returned", "uniqueSeen", "total", "snapshotGuaranteed", "completeness"], "properties": {"returned": {"type": "integer", "minimum": 0}, "uniqueSeen": {"type": "integer", "minimum": 0, "description": "Distinct review identities (stable source IDs are deduplicated; ID-less rows remain distinct) returned across this cursor chain, including the current response; replaying a cursor is stable and a fresh query/refinement starts a new chain."}, "total": {"type": ["integer", "null"], "minimum": 0}, "snapshotGuaranteed": {"const": false}, "completeness": {"enum": ["complete", "partial", "unknown"]}}, "additionalProperties": false},
    "context": {"type": "object", "required": ["contextId", "regionLabel", "regionVerification", "accountState", "accessState"], "properties": {"contextId": {"$ref": "#/$defs/opaque"}, "regionLabel": {"type": ["string", "null"], "maxLength": 500}, "regionVerification": {"enum": ["verified", "unverified"]}, "accountState": {"enum": ["authenticated", "anonymous", "unknown"]}, "accessState": {"enum": ["available", "blocked", "unknown"]}}, "additionalProperties": false},
    "evidence": {"type": "object", "required": ["evidenceRef", "sourceKind", "sourceUrl", "observedAt", "contextId", "sku", "fieldPaths"], "properties": {"evidenceRef": {"$ref": "#/$defs/opaque"}, "sourceKind": {"enum": ["ozon_page", "local_journal"]}, "sourceUrl": {"oneOf": [{"type": "string", "format": "uri", "maxLength": 2048}, {"type": "null"}]}, "observedAt": {"$ref": "#/$defs/timestamp"}, "contextId": {"$ref": "#/$defs/opaque"}, "sku": {"oneOf": [{"type": "string", "pattern": "^[0-9]+$", "maxLength": 64}, {"type": "null"}]}, "fieldPaths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:|/(?:[^~/]|~[01])*)*$", "maxLength": 500}}}, "additionalProperties": false, "allOf": [{"if": {"properties": {"sourceKind": {"const": "local_journal"}}}, "then": {"properties": {"sourceUrl": {"type": "null"}}}}, {"if": {"properties": {"sourceKind": {"const": "ozon_page"}}}, "then": {"properties": {"sourceUrl": {"type": "string", "format": "uri", "pattern": "^https://(?:www\\.)?ozon\\.ru/[^?#]*$"}}}}]},
    "warning": {"type": "object", "required": ["code", "message", "evidenceRefs"], "properties": {"code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 128}, "message": {"type": "string", "minLength": 1, "maxLength": 2000}, "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}}, "additionalProperties": false}
  }
}
