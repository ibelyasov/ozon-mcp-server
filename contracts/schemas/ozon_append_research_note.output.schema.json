{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ozon_append_research_note success output",
  "type": "object",
  "required": [
    "schemaVersion",
    "researchId",
    "data",
    "context",
    "observedAt",
    "evidence",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "3"
    },
    "researchId": {
      "$ref": "common.schema.json#/$defs/opaque"
    },
    "data": {
      "type": "object",
      "required": [
        "noteId",
        "createdAt",
        "author"
      ],
      "properties": {
        "noteId": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "createdAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "author": {
          "const": "agent"
        }
      },
      "additionalProperties": false
    },
    "context": {
      "$ref": "common.schema.json#/$defs/context"
    },
    "observedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "evidence": {
      "type": "array",
      "maxItems": 0
    },
    "warnings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "common.schema.json#/$defs/warning"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {}
}
