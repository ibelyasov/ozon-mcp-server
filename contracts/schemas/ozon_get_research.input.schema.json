{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ozon_get_research input",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/defaultSummary"
    },
    {
      "$ref": "#/$defs/summarySection"
    },
    {
      "$ref": "#/$defs/pagedEvents"
    },
    {
      "$ref": "#/$defs/pagedNotes"
    },
    {
      "$ref": "#/$defs/pagedEvidence"
    },
    {
      "$ref": "#/$defs/selectedEvidence"
    },
    {
      "$ref": "#/$defs/selectedNotes"
    },
    {
      "$ref": "#/$defs/selectedCandidates"
    }
  ],
  "$defs": {
    "defaultSummary": {
      "type": "object",
      "required": [
        "researchId"
      ],
      "properties": {
        "researchId": {
          "$ref": "common.schema.json#/$defs/opaque"
        }
      },
      "additionalProperties": false
    },
    "pagedEvidence": {
      "type": "object",
      "required": [
        "researchId",
        "section"
      ],
      "properties": {
        "researchId": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "section": {
          "const": "evidence"
        },
        "cursor": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25,
          "default": 20
        }
      },
      "additionalProperties": false
    },
    "selectedEvidence": {
      "type": "object",
      "required": [
        "researchId",
        "section",
        "evidenceRefs"
      ],
      "properties": {
        "researchId": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "section": {
          "const": "evidence"
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/opaque"
          }
        }
      },
      "additionalProperties": false
    },
    "selectedCandidates": {
      "type": "object",
      "required": [
        "researchId",
        "section",
        "productRefs"
      ],
      "properties": {
        "researchId": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "section": {
          "const": "candidates"
        },
        "productRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/opaque"
          }
        }
      },
      "additionalProperties": false
    },
    "summarySection": {
      "type": "object",
      "required": [
        "researchId",
        "section"
      ],
      "properties": {
        "researchId": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "section": {
          "const": "summary"
        }
      },
      "additionalProperties": false
    },
    "pagedEvents": {
      "type": "object",
      "required": [
        "researchId",
        "section"
      ],
      "properties": {
        "researchId": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "section": {
          "const": "events"
        },
        "cursor": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25,
          "default": 25
        }
      },
      "additionalProperties": false
    },
    "pagedNotes": {
      "type": "object",
      "required": [
        "researchId",
        "section"
      ],
      "properties": {
        "researchId": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "section": {
          "const": "notes"
        },
        "cursor": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25,
          "default": 10
        }
      },
      "additionalProperties": false
    },
    "selectedNotes": {
      "type": "object",
      "required": [
        "researchId",
        "section",
        "noteIds"
      ],
      "properties": {
        "researchId": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "section": {
          "const": "notes"
        },
        "noteIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/opaque"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
