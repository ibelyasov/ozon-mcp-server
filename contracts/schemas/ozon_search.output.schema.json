{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ozon_search success output",
  "type": "object",
  "required": [
    "schemaVersion",
    "researchId",
    "data",
    "context",
    "observedAt",
    "evidence",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "3"
    },
    "researchId": {
      "$ref": "common.schema.json#/$defs/opaque"
    },
    "data": {
      "type": "object",
      "required": [
        "items",
        "refinements",
        "refinementsIncluded",
        "refinementsTruncated",
        "nextCursor",
        "hasNext",
        "coverage"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 36,
          "items": {
            "$ref": "#/$defs/productSummary"
          }
        },
        "refinements": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/refinement"
          }
        },
        "refinementsIncluded": {
          "type": "boolean"
        },
        "refinementsTruncated": {
          "type": "boolean"
        },
        "refinementsNextCursor": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/opaque"
            },
            {
              "type": "null"
            }
          ]
        },
        "refinementsTotal": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "refinementsSourceTruncated": {
          "type": "boolean"
        },
        "nextCursor": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/opaque"
            },
            {
              "type": "null"
            }
          ]
        },
        "hasNext": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "priceRangeAssessment": {
          "type": "object",
          "required": [
            "basis",
            "sourceFilterGuaranteesMatch"
          ],
          "properties": {
            "basis": {
              "const": "displayed_search_price"
            },
            "sourceFilterGuaranteesMatch": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        }
      },
      "additionalProperties": false
    },
    "context": {
      "$ref": "common.schema.json#/$defs/context"
    },
    "observedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "evidence": {
      "type": "array",
      "maxItems": 0
    },
    "warnings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "common.schema.json#/$defs/warning"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "productSummary": {
      "type": "object",
      "required": [
        "productRef",
        "sku",
        "title",
        "url",
        "availability",
        "prices",
        "matchesDisplayedPriceRange",
        "seller",
        "deliveryLabel",
        "rating",
        "reviewCount",
        "imageRefs",
        "evidenceRefs"
      ],
      "properties": {
        "productRef": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "sku": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 64
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "pattern": "^https://(?:www\\.)?ozon\\.ru(?:/|$)",
          "maxLength": 2048
        },
        "availability": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ]
        },
        "prices": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "common.schema.json#/$defs/price"
          }
        },
        "matchesDisplayedPriceRange": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "seller": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/seller"
            },
            {
              "type": "null"
            }
          ]
        },
        "deliveryLabel": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "rating": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 5
        },
        "reviewCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "imageRefs": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/opaque"
          }
        },
        "evidenceRefs": {
          "$ref": "common.schema.json#/$defs/evidenceRefs"
        }
      },
      "additionalProperties": false
    },
    "refinement": {
      "type": "object",
      "required": [
        "kind",
        "label",
        "groupLabel",
        "selected",
        "searchRef"
      ],
      "properties": {
        "kind": {
          "enum": [
            "filter",
            "sort"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "groupLabel": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "selected": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "searchRef": {
          "$ref": "common.schema.json#/$defs/opaque"
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "returned",
        "uniqueSeen",
        "total",
        "snapshotGuaranteed",
        "completeness"
      ],
      "properties": {
        "returned": {
          "type": "integer",
          "minimum": 0
        },
        "uniqueSeen": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "snapshotGuaranteed": {
          "const": false
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
