{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ozon_get_products input",
  "type": "object",
  "required": [
    "products"
  ],
  "properties": {
    "products": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "$ref": "common.schema.json#/$defs/productRefSelector"
          },
          {
            "$ref": "common.schema.json#/$defs/skuSelector"
          },
          {
            "$ref": "common.schema.json#/$defs/urlSelector"
          },
          {
            "$ref": "common.schema.json#/$defs/cursorSelector"
          }
        ]
      }
    },
    "researchId": {
      "$ref": "common.schema.json#/$defs/opaque"
    },
    "include": {
      "type": "array",
      "uniqueItems": true,
      "default": [
        "characteristics"
      ],
      "items": {
        "enum": [
          "characteristics",
          "description",
          "variants",
          "images"
        ]
      },
      "description": "Default includes characteristics. Explicit sections are returned in full or with truthful bounded continuation."
    }
  },
  "additionalProperties": false,
  "$defs": {},
  "if": {
    "properties": {
      "products": {
        "contains": {
          "type": "object",
          "required": [
            "cursor"
          ]
        }
      }
    },
    "required": [
      "products"
    ]
  },
  "then": {
    "properties": {
      "include": false
    }
  }
}
