{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ozon_get_products success output",
  "type": "object",
  "required": ["schemaVersion", "researchId", "data", "context", "observedAt", "evidence", "warnings"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "researchId": {"$ref": "#/$defs/opaque"},
    "data": {
      "type": "object",
      "required": ["results"],
      "properties": {"results": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/result"}}},
      "additionalProperties": false
    },
    "context": {"$ref": "#/$defs/context"},
    "observedAt": {"$ref": "#/$defs/timestamp"},
    "evidence": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/evidence"}},
    "warnings": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/warning"}}
  },
  "additionalProperties": false,
  "$defs": {
    "opaque": {"type": "string", "minLength": 1, "maxLength": 2048},
    "timestamp": {"type": "string", "format": "date-time"},
    "evidenceRefs": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/opaque"}},
    "productRefSelector": {"type": "object", "required": ["productRef"], "properties": {"productRef": {"$ref": "#/$defs/opaque"}}, "additionalProperties": false},
    "skuSelector": {"type": "object", "required": ["sku"], "properties": {"sku": {"type": "string", "pattern": "^[0-9]+$", "maxLength": 64}}, "additionalProperties": false},
    "urlSelector": {"type": "object", "required": ["url"], "properties": {"url": {"type": "string", "format": "uri", "pattern": "^https://(?:www\\.)?ozon\\.ru(?:/|$)", "maxLength": 2048}}, "additionalProperties": false},
    "cursorSelector": {"type": "object", "required": ["cursor"], "properties": {"cursor": {"$ref": "#/$defs/opaque"}}, "additionalProperties": false},
    "selector": {"oneOf": [{"$ref": "#/$defs/productRefSelector"}, {"$ref": "#/$defs/skuSelector"}, {"$ref": "#/$defs/urlSelector"}, {"$ref": "#/$defs/cursorSelector"}]},
    "price": {"type": "object", "required": ["amountMinor", "currency", "type", "condition", "evidenceRefs"], "properties": {"amountMinor": {"type": ["integer", "null"], "minimum": 0}, "currency": {"const": "RUB"}, "type": {"enum": ["ozon_card", "regular", "unknown"]}, "condition": {"type": ["string", "null"], "maxLength": 500}, "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}}, "additionalProperties": false},
    "sectionBase": {"type": "object", "required": ["status", "truncated", "nextCursor", "hasNext"], "properties": {"status": {"enum": ["available", "unsupported", "unknown", "partial"]}, "truncated": {"type": "boolean"}, "nextCursor": {"oneOf": [{"$ref": "#/$defs/opaque"}, {"type": "null"}]}, "hasNext": {"type": ["boolean", "null"]}}},
    "characteristic": {"type": "object", "required": ["name", "value", "evidenceRefs"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 500}, "value": {"type": ["string", "null"], "maxLength": 4000}, "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}}, "additionalProperties": false},
    "characteristicsSection": {"allOf": [{"$ref": "#/$defs/sectionBase"}, {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/characteristic"}}}}], "unevaluatedProperties": false},
    "descriptionSection": {"allOf": [{"$ref": "#/$defs/sectionBase"}, {"type": "object", "required": ["text", "evidenceRefs"], "properties": {"text": {"type": ["string", "null"], "maxLength": 12000}, "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}}}], "unevaluatedProperties": false},
    "variant": {"type": "object", "required": ["productRef", "sku", "title", "evidenceRefs"], "properties": {"productRef": {"$ref": "#/$defs/opaque"}, "sku": {"type": "string", "pattern": "^[0-9]+$", "maxLength": 64}, "title": {"type": ["string", "null"], "maxLength": 1000}, "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}}, "additionalProperties": false},
    "variantsSection": {"allOf": [{"$ref": "#/$defs/sectionBase"}, {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/variant"}}}}], "unevaluatedProperties": false},
    "delivery": {"type": "object", "required": ["label", "dateFrom", "dateTo"], "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 1000}, "dateFrom": {"type": ["string", "null"], "format": "date"}, "dateTo": {"type": ["string", "null"], "format": "date"}}, "additionalProperties": false},
    "seller": {"type": "object", "required": ["name", "rating", "url", "evidenceRefs"], "properties": {"name": {"type": ["string", "null"], "maxLength": 500}, "rating": {"type": ["number", "null"], "minimum": 0, "maximum": 5}, "url": {"oneOf": [{"type": "string", "format": "uri", "pattern": "^https://(?:www\\.)?ozon\\.ru/[^?#]*$", "maxLength": 2048}, {"type": "null"}]}, "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}}, "additionalProperties": false},
    "offer": {"type": "object", "required": ["offerRef", "url", "availability", "seller", "prices", "delivery", "evidenceRefs"], "properties": {"offerRef": {"oneOf": [{"$ref": "#/$defs/opaque"}, {"type": "null"}]}, "url": {"oneOf": [{"type": "string", "format": "uri", "pattern": "^https://(?:www\\.)?ozon\\.ru/[^?#]*$", "maxLength": 2048}, {"type": "null"}]}, "availability": {"enum": ["available", "unavailable", "unknown"]}, "seller": {"oneOf": [{"$ref": "#/$defs/seller"}, {"type": "null"}]}, "prices": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/price"}}, "delivery": {"oneOf": [{"$ref": "#/$defs/delivery"}, {"type": "null"}]}, "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}}, "additionalProperties": false},
    "offersSection": {"allOf": [{"$ref": "#/$defs/sectionBase"}, {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/offer"}}}}], "unevaluatedProperties": false},
    "image": {"type": "object", "required": ["imageRef", "altText", "evidenceRefs"], "properties": {"imageRef": {"$ref": "#/$defs/opaque"}, "altText": {"type": ["string", "null"], "maxLength": 1000}, "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}}, "additionalProperties": false},
    "imagesSection": {"allOf": [{"$ref": "#/$defs/sectionBase"}, {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/image"}}}}], "unevaluatedProperties": false},
    "fieldEvidence": {"type": "object", "required": ["fieldPath", "evidenceRefs"], "properties": {"fieldPath": {"type": "string", "pattern": "^(?:|/(?:[^~/]|~[01])*)*$", "maxLength": 500}, "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}}, "additionalProperties": false},
    "product": {"type": "object", "required": ["productRef", "sku", "title", "url", "availability", "prices", "seller", "rating", "reviewCount", "fieldEvidence", "evidenceRefs"], "properties": {"productRef": {"$ref": "#/$defs/opaque"}, "sku": {"type": "string", "pattern": "^[0-9]+$", "maxLength": 64}, "title": {"type": ["string", "null"], "maxLength": 1000}, "url": {"type": "string", "format": "uri", "pattern": "^https://(?:www\\.)?ozon\\.ru(?:/|$)", "maxLength": 2048}, "availability": {"enum": ["available", "unavailable", "unknown"]}, "prices": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/price"}}, "seller": {"oneOf": [{"$ref": "#/$defs/seller"}, {"type": "null"}]}, "rating": {"type": ["number", "null"], "minimum": 0, "maximum": 5}, "reviewCount": {"type": ["integer", "null"], "minimum": 0}, "characteristics": {"$ref": "#/$defs/characteristicsSection"}, "description": {"$ref": "#/$defs/descriptionSection"}, "variants": {"$ref": "#/$defs/variantsSection"}, "offers": {"$ref": "#/$defs/offersSection"}, "images": {"$ref": "#/$defs/imagesSection"}, "fieldEvidence": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/fieldEvidence"}}, "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}}, "additionalProperties": false},
    "itemError": {"type": "object", "required": ["code", "message", "retryable"], "properties": {"code": {"enum": ["INVALID_REFERENCE", "CONTEXT_CHANGED", "CONTEXT_UNVERIFIED", "RESEARCH_EXPIRED", "UNSUPPORTED_CAPABILITY", "SOURCE_BLOCKED", "SOURCE_CHANGED", "UPSTREAM_TIMEOUT", "NOT_FOUND", "RESULT_TOO_LARGE"]}, "message": {"type": "string", "minLength": 1, "maxLength": 2000}, "retryable": {"type": "boolean"}}, "additionalProperties": false},
    "okResult": {"type": "object", "required": ["status", "requested", "product"], "properties": {"status": {"const": "ok"}, "requested": {"$ref": "#/$defs/selector"}, "product": {"$ref": "#/$defs/product"}}, "additionalProperties": false},
    "errorResult": {"type": "object", "required": ["status", "requested", "error"], "properties": {"status": {"const": "error"}, "requested": {"$ref": "#/$defs/selector"}, "error": {"$ref": "#/$defs/itemError"}}, "additionalProperties": false},
    "result": {"oneOf": [{"$ref": "#/$defs/okResult"}, {"$ref": "#/$defs/errorResult"}]},
    "context": {"type": "object", "required": ["contextId", "regionLabel", "regionVerification", "accountState", "accessState"], "properties": {"contextId": {"$ref": "#/$defs/opaque"}, "regionLabel": {"type": ["string", "null"], "maxLength": 500}, "regionVerification": {"enum": ["verified", "unverified"]}, "accountState": {"enum": ["authenticated", "anonymous", "unknown"]}, "accessState": {"enum": ["available", "blocked", "unknown"]}}, "additionalProperties": false},
    "evidence": {"type": "object", "required": ["evidenceRef", "sourceKind", "sourceUrl", "observedAt", "contextId", "sku", "fieldPaths"], "properties": {"evidenceRef": {"$ref": "#/$defs/opaque"}, "sourceKind": {"enum": ["ozon_page", "local_journal"]}, "sourceUrl": {"oneOf": [{"type": "string", "format": "uri", "maxLength": 2048}, {"type": "null"}]}, "observedAt": {"$ref": "#/$defs/timestamp"}, "contextId": {"$ref": "#/$defs/opaque"}, "sku": {"oneOf": [{"type": "string", "pattern": "^[0-9]+$", "maxLength": 64}, {"type": "null"}]}, "fieldPaths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:|/(?:[^~/]|~[01])*)*$", "maxLength": 500}}}, "additionalProperties": false, "allOf": [{"if": {"properties": {"sourceKind": {"const": "local_journal"}}}, "then": {"properties": {"sourceUrl": {"type": "null"}}}}, {"if": {"properties": {"sourceKind": {"const": "ozon_page"}}}, "then": {"properties": {"sourceUrl": {"type": "string", "format": "uri", "pattern": "^https://(?:www\\.)?ozon\\.ru/[^?#]*$"}}}}]},
    "warning": {"type": "object", "required": ["code", "message", "evidenceRefs"], "properties": {"code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 128}, "message": {"type": "string", "minLength": 1, "maxLength": 2000}, "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}}, "additionalProperties": false}
  }
}
