{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ozon_get_products success output",
  "type": "object",
  "required": [
    "schemaVersion",
    "researchId",
    "data",
    "context",
    "observedAt",
    "evidence",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "3"
    },
    "researchId": {
      "$ref": "common.schema.json#/$defs/opaque"
    },
    "data": {
      "type": "object",
      "required": [
        "results"
      ],
      "properties": {
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/result"
          }
        }
      },
      "additionalProperties": false
    },
    "context": {
      "$ref": "common.schema.json#/$defs/context"
    },
    "observedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "evidence": {
      "type": "array",
      "maxItems": 0
    },
    "warnings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "common.schema.json#/$defs/warning"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "selector": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/productRefSelector"
        },
        {
          "$ref": "common.schema.json#/$defs/skuSelector"
        },
        {
          "$ref": "common.schema.json#/$defs/urlSelector"
        },
        {
          "$ref": "common.schema.json#/$defs/cursorSelector"
        }
      ]
    },
    "sectionBase": {
      "type": "object",
      "required": [
        "status",
        "truncated",
        "nextCursor",
        "hasNext"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "unsupported",
            "unknown",
            "partial"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "nextCursor": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/opaque"
            },
            {
              "type": "null"
            }
          ]
        },
        "hasNext": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "characteristic": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000
        },
        "evidenceRefs": {
          "$ref": "common.schema.json#/$defs/evidenceRefs"
        }
      },
      "additionalProperties": false
    },
    "characteristicsSection": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "$ref": "#/$defs/characteristic"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "descriptionSection": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 12000
            },
            "evidenceRefs": {
              "$ref": "common.schema.json#/$defs/evidenceRefs"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "variant": {
      "type": "object",
      "required": [
        "productRef",
        "sku",
        "title"
      ],
      "properties": {
        "productRef": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "sku": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 64
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "evidenceRefs": {
          "$ref": "common.schema.json#/$defs/evidenceRefs"
        }
      },
      "additionalProperties": false
    },
    "variantsSection": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/variant"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "delivery": {
      "type": "object",
      "required": [
        "label",
        "dateFrom",
        "dateTo"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "dateFrom": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "dateTo": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "required": [
        "imageRef",
        "altText"
      ],
      "properties": {
        "imageRef": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "altText": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "evidenceRefs": {
          "$ref": "common.schema.json#/$defs/evidenceRefs"
        }
      },
      "additionalProperties": false
    },
    "imagesSection": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "$ref": "#/$defs/image"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "product": {
      "type": "object",
      "required": [
        "productRef",
        "sku",
        "title",
        "availability",
        "prices",
        "customsDuty",
        "seller",
        "rating",
        "reviewCount",
        "evidenceRefs",
        "url",
        "deliveryLabel"
      ],
      "properties": {
        "productRef": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "sku": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 64
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "pattern": "^https://(?:www\\.)?ozon\\.ru(?:/|$)",
          "maxLength": 2048
        },
        "availability": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ]
        },
        "prices": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "common.schema.json#/$defs/price"
          }
        },
        "customsDuty": {
          "type": "object",
          "required": [
            "status",
            "amountMinor",
            "currency",
            "label"
          ],
          "properties": {
            "status": {
              "enum": [
                "available",
                "unknown"
              ]
            },
            "amountMinor": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "currency": {
              "const": "RUB"
            },
            "label": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2000
            }
          },
          "additionalProperties": false
        },
        "seller": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/seller"
            },
            {
              "type": "null"
            }
          ]
        },
        "rating": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 5
        },
        "reviewCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "characteristics": {
          "$ref": "#/$defs/characteristicsSection"
        },
        "description": {
          "$ref": "#/$defs/descriptionSection"
        },
        "variants": {
          "$ref": "#/$defs/variantsSection"
        },
        "images": {
          "$ref": "#/$defs/imagesSection"
        },
        "evidenceRefs": {
          "$ref": "common.schema.json#/$defs/evidenceRefs"
        },
        "deliveryLabel": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      },
      "additionalProperties": false
    },
    "itemError": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "enum": [
            "INVALID_REFERENCE",
            "CONTEXT_CHANGED",
            "CONTEXT_UNVERIFIED",
            "RESEARCH_EXPIRED",
            "UNSUPPORTED_CAPABILITY",
            "SOURCE_BLOCKED",
            "SOURCE_CHANGED",
            "UPSTREAM_TIMEOUT",
            "NOT_FOUND",
            "RESULT_TOO_LARGE"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "okResult": {
      "type": "object",
      "required": [
        "status",
        "requested",
        "product"
      ],
      "properties": {
        "status": {
          "const": "ok"
        },
        "requested": {
          "$ref": "#/$defs/selector"
        },
        "product": {
          "$ref": "#/$defs/product"
        }
      },
      "additionalProperties": false
    },
    "errorResult": {
      "type": "object",
      "required": [
        "status",
        "requested",
        "error"
      ],
      "properties": {
        "status": {
          "const": "error"
        },
        "requested": {
          "$ref": "#/$defs/selector"
        },
        "error": {
          "$ref": "#/$defs/itemError"
        }
      },
      "additionalProperties": false
    },
    "result": {
      "oneOf": [
        {
          "$ref": "#/$defs/okResult"
        },
        {
          "$ref": "#/$defs/errorResult"
        }
      ]
    }
  }
}
