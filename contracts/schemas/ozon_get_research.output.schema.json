{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ozon_get_research success output",
  "type": "object",
  "required": [
    "schemaVersion",
    "researchId",
    "data",
    "context",
    "observedAt",
    "evidence",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "3"
    },
    "researchId": {
      "$ref": "common.schema.json#/$defs/opaque"
    },
    "data": {
      "oneOf": [
        {
          "$ref": "#/$defs/summaryData"
        },
        {
          "$ref": "#/$defs/eventsData"
        },
        {
          "$ref": "#/$defs/evidenceData"
        },
        {
          "$ref": "#/$defs/notesData"
        },
        {
          "$ref": "#/$defs/candidatesData"
        }
      ]
    },
    "context": {
      "$ref": "common.schema.json#/$defs/context"
    },
    "observedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "evidence": {
      "type": "array",
      "maxItems": 0
    },
    "warnings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "common.schema.json#/$defs/warning"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "productRefs": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/opaque"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "researchId",
        "title",
        "createdAt",
        "updatedAt",
        "contextId",
        "productCount",
        "productRefs",
        "productRefsTruncated",
        "eventCount",
        "evidenceCount",
        "noteCount"
      ],
      "properties": {
        "researchId": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "createdAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "updatedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "contextId": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "productCount": {
          "type": "integer",
          "minimum": 0
        },
        "productRefs": {
          "$ref": "#/$defs/productRefs"
        },
        "productRefsTruncated": {
          "type": "boolean"
        },
        "eventCount": {
          "type": "integer",
          "minimum": 0
        },
        "evidenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "noteCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "eventId",
        "kind",
        "observedAt",
        "summary",
        "productRefs",
        "evidenceRefs"
      ],
      "properties": {
        "eventId": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "kind": {
          "enum": [
            "context_observed",
            "search",
            "products",
            "reviews",
            "images",
            "note_appended",
            "warning",
            "cancelled"
          ]
        },
        "observedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "productRefs": {
          "type": "array",
          "maxItems": 36,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/opaque"
          }
        },
        "evidenceRefs": {
          "$ref": "common.schema.json#/$defs/evidenceRefs"
        }
      },
      "additionalProperties": false
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ],
      "maxLength": 12000
    },
    "factValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/scalar"
          }
        }
      ]
    },
    "fact": {
      "type": "object",
      "required": [
        "fieldPath",
        "value"
      ],
      "properties": {
        "fieldPath": {
          "type": "string",
          "pattern": "^(?:|/(?:[^~/]|~[01])*)*$",
          "maxLength": 500
        },
        "value": {
          "$ref": "#/$defs/factValue"
        }
      },
      "additionalProperties": false
    },
    "storedEvidence": {
      "type": "object",
      "required": [
        "evidenceRef",
        "sourceKind",
        "sourceUrl",
        "observedAt",
        "contextId",
        "sku",
        "facts"
      ],
      "properties": {
        "evidenceRef": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "sourceKind": {
          "enum": [
            "ozon_page",
            "local_journal"
          ]
        },
        "sourceUrl": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "observedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "contextId": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "sku": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "facts": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "sourceKind": {
                "const": "local_journal"
              }
            }
          },
          "then": {
            "properties": {
              "sourceUrl": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sourceKind": {
                "const": "ozon_page"
              }
            }
          },
          "then": {
            "properties": {
              "sourceUrl": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://(?:www\\.)?ozon\\.ru/[^?#]*$"
              }
            }
          }
        }
      ]
    },
    "note": {
      "type": "object",
      "required": [
        "noteId",
        "operationId",
        "kind",
        "text",
        "createdAt",
        "author",
        "evidenceRefs",
        "productRefs"
      ],
      "properties": {
        "noteId": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "enum": [
            "requirements",
            "assessment",
            "conclusion"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "createdAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "author": {
          "const": "agent"
        },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/opaque"
          }
        },
        "productRefs": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/opaque"
          }
        }
      },
      "additionalProperties": false
    },
    "candidateSnapshot": {
      "type": "object",
      "description": "Immutable normalized search-row snapshot captured when its Product Reference was committed.",
      "required": [
        "productRef",
        "sku",
        "title",
        "url",
        "availability",
        "prices",
        "seller",
        "deliveryLabel",
        "rating",
        "reviewCount",
        "imageRefs",
        "evidenceRefs",
        "observedAt",
        "contextId"
      ],
      "properties": {
        "productRef": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "sku": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 64
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "pattern": "^https://(?:www\\.)?ozon\\.ru(?:/|$)",
          "maxLength": 2048
        },
        "availability": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ]
        },
        "prices": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "common.schema.json#/$defs/price"
          }
        },
        "matchesDisplayedPriceRange": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "seller": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/seller"
            },
            {
              "type": "null"
            }
          ]
        },
        "deliveryLabel": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "rating": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 5
        },
        "reviewCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "imageRefs": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/opaque"
          }
        },
        "evidenceRefs": {
          "$ref": "common.schema.json#/$defs/evidenceRefs"
        },
        "observedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "contextId": {
          "$ref": "common.schema.json#/$defs/opaque"
        }
      },
      "additionalProperties": false
    },
    "summaryData": {
      "type": "object",
      "required": [
        "section",
        "payload",
        "nextCursor"
      ],
      "properties": {
        "section": {
          "const": "summary"
        },
        "payload": {
          "$ref": "#/$defs/summary"
        },
        "nextCursor": {
          "type": "null"
        }
      },
      "additionalProperties": false
    },
    "eventsData": {
      "type": "object",
      "required": [
        "section",
        "payload",
        "nextCursor"
      ],
      "properties": {
        "section": {
          "const": "events"
        },
        "payload": {
          "type": "array",
          "maxItems": 25,
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "nextCursor": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/opaque"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "evidenceData": {
      "type": "object",
      "required": [
        "section",
        "payload",
        "nextCursor"
      ],
      "properties": {
        "section": {
          "const": "evidence"
        },
        "payload": {
          "type": "array",
          "maxItems": 25,
          "items": {
            "$ref": "#/$defs/storedEvidence"
          }
        },
        "nextCursor": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/opaque"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "notesData": {
      "type": "object",
      "required": [
        "section",
        "payload",
        "nextCursor"
      ],
      "properties": {
        "section": {
          "const": "notes"
        },
        "payload": {
          "type": "array",
          "maxItems": 25,
          "items": {
            "$ref": "#/$defs/note"
          }
        },
        "nextCursor": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/opaque"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "candidatesData": {
      "type": "object",
      "required": [
        "section",
        "payload",
        "nextCursor"
      ],
      "properties": {
        "section": {
          "const": "candidates"
        },
        "payload": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/candidateSnapshot"
          }
        },
        "nextCursor": {
          "type": "null"
        }
      },
      "additionalProperties": false
    }
  }
}
