{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ozon_get_context success output",
  "type": "object",
  "required": [
    "schemaVersion",
    "researchId",
    "data",
    "context",
    "observedAt",
    "evidence",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "3"
    },
    "researchId": {
      "type": "null"
    },
    "data": {
      "type": "object",
      "required": [
        "contextId",
        "observedAt",
        "region",
        "accountState",
        "accessState",
        "capabilities"
      ],
      "properties": {
        "contextId": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "observedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "region": {
          "type": "object",
          "required": [
            "label",
            "verification",
            "evidenceRefs"
          ],
          "properties": {
            "label": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 500
            },
            "verification": {
              "enum": [
                "verified",
                "unverified"
              ]
            },
            "evidenceRefs": {
              "$ref": "common.schema.json#/$defs/evidenceRefs"
            }
          },
          "additionalProperties": false
        },
        "accountState": {
          "enum": [
            "authenticated",
            "anonymous",
            "unknown"
          ]
        },
        "accessState": {
          "enum": [
            "available",
            "blocked",
            "unknown"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "status",
              "reason"
            ],
            "properties": {
              "name": {
                "enum": [
                  "search",
                  "search_refinements",
                  "search_pagination",
                  "card_prices",
                  "products",
                  "characteristics",
                  "description",
                  "variants",
                  "offers",
                  "review_text",
                  "review_refinements",
                  "review_pagination",
                  "review_images",
                  "product_images",
                  "image_content",
                  "region_verification",
                  "account_observation"
                ]
              },
              "status": {
                "enum": [
                  "supported",
                  "unsupported"
                ],
                "description": "Static implementation support; current access and region verification are separate context observations."
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1000
              },
              "evidenceRefs": {
                "type": "array",
                "maxItems": 0
              }
            },
            "additionalProperties": false
          },
          "minItems": 17,
          "maxItems": 17
        }
      },
      "additionalProperties": false
    },
    "context": {
      "$ref": "common.schema.json#/$defs/context"
    },
    "observedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "evidence": {
      "type": "array",
      "maxItems": 0
    },
    "warnings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "common.schema.json#/$defs/warning"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {}
}
