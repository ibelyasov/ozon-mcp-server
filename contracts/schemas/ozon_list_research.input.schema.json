{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ozon_list_research input",
  "type": "object",
  "properties": {
    "query": {"type": "string", "minLength": 1, "maxLength": 200},
    "cursor": {"$ref": "#/$defs/opaque"},
