{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ozon_list_research success output",
  "type": "object",
  "required": [
    "schemaVersion",
    "researchId",
    "data",
    "context",
    "observedAt",
    "evidence",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "3"
    },
    "researchId": {
      "type": "null"
    },
    "data": {
      "type": "object",
      "required": [
        "researches",
        "nextCursor"
      ],
      "properties": {
        "researches": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/research"
          }
        },
        "nextCursor": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/opaque"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "context": {
      "$ref": "common.schema.json#/$defs/context"
    },
    "observedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "evidence": {
      "type": "array",
      "maxItems": 0
    },
    "warnings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "common.schema.json#/$defs/warning"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "research": {
      "type": "object",
      "required": [
        "researchId",
        "title",
        "createdAt",
        "updatedAt",
        "contextId"
      ],
      "properties": {
        "researchId": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "createdAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "updatedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "contextId": {
          "$ref": "common.schema.json#/$defs/opaque"
        }
      },
      "additionalProperties": false
    }
  }
}
