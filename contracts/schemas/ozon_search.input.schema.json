{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ozon_search input",
  "type": "object",
  "required": [
    "start"
  ],
  "properties": {
    "start": {
      "oneOf": [
        {
          "$ref": "#/$defs/queryStart"
        },
        {
          "$ref": "#/$defs/referenceStart"
        },
        {
          "$ref": "common.schema.json#/$defs/cursorStart"
        },
        {
          "$ref": "#/$defs/refinementsStart"
        }
      ]
    },
    "researchId": {
      "$ref": "common.schema.json#/$defs/opaque"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 36,
      "default": 12
    },
    "includeFacets": {
      "type": "boolean",
      "description": "Request bounded filter and sort refinements explicitly.",
      "default": false
    },
    "refinementLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 12
    }
  },
  "additionalProperties": false,
  "$defs": {
    "priceRange": {
      "type": "object",
      "properties": {
        "minMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "queryStart": {
      "type": "object",
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "priceRange": {
          "$ref": "#/$defs/priceRange"
        }
      },
      "additionalProperties": false
    },
    "referenceStart": {
      "type": "object",
      "required": [
        "searchRef"
      ],
      "properties": {
        "searchRef": {
          "$ref": "common.schema.json#/$defs/opaque"
        },
        "priceRange": {
          "$ref": "#/$defs/priceRange"
        }
      },
      "additionalProperties": false
    },
    "refinementsStart": {
      "type": "object",
      "required": [
        "refinementsCursor"
      ],
      "properties": {
        "refinementsCursor": {
          "$ref": "common.schema.json#/$defs/opaque"
        }
      },
      "additionalProperties": false
    }
  }
}
