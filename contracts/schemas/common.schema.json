{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared public contract definitions",
  "type": "object",
  "$defs": {
    "opaque": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/opaque"
      }
    },
    "price": {
      "type": "object",
      "required": [
        "amountMinor",
        "currency",
        "type",
        "condition"
      ],
      "properties": {
        "amountMinor": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "const": "RUB"
        },
        "type": {
          "enum": [
            "ozon_card",
            "regular",
            "unknown"
          ]
        },
        "condition": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      },
      "additionalProperties": false
    },
    "seller": {
      "type": "object",
      "required": [
        "name",
        "rating",
        "url"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "rating": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 5
        },
        "url": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://(?:www\\.)?ozon\\.ru/[^?#]*$",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": [
        "contextId",
        "regionLabel",
        "regionVerification",
        "accountState",
        "accessState"
      ],
      "properties": {
        "contextId": {
          "$ref": "#/$defs/opaque"
        },
        "regionLabel": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "regionVerification": {
          "enum": [
            "verified",
            "unverified"
          ]
        },
        "accountState": {
          "enum": [
            "authenticated",
            "anonymous",
            "unknown"
          ]
        },
        "accessState": {
          "enum": [
            "available",
            "blocked",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    },
    "warning": {
      "type": "object",
      "required": [
        "code",
        "message",
        "evidenceRefs"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      },
      "additionalProperties": false
    },
    "productRefSelector": {
      "type": "object",
      "required": [
        "productRef"
      ],
      "properties": {
        "productRef": {
          "$ref": "#/$defs/opaque"
        }
      },
      "additionalProperties": false
    },
    "skuSelector": {
      "type": "object",
      "required": [
        "sku"
      ],
      "properties": {
        "sku": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "urlSelector": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?:www\\.)?ozon\\.ru(?:/|$)",
          "maxLength": 2048
        }
      },
      "additionalProperties": false
    },
    "cursorSelector": {
      "type": "object",
      "required": [
        "cursor"
      ],
      "properties": {
        "cursor": {
          "$ref": "#/$defs/opaque"
        }
      },
      "additionalProperties": false
    },
    "cursorStart": {
      "type": "object",
      "required": [
        "cursor"
      ],
      "properties": {
        "cursor": {
          "$ref": "#/$defs/opaque"
        }
      },
      "additionalProperties": false
    },
    "productSectionBase": {
      "type": "object",
      "required": [
        "status",
        "truncated",
        "nextCursor",
        "hasNext"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "unsupported",
            "unknown",
            "partial"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "nextCursor": {
          "oneOf": [
            {
              "$ref": "#/$defs/opaque"
            },
            {
              "type": "null"
            }
          ]
        },
        "hasNext": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "productCharacteristic": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000
        },
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      },
      "additionalProperties": false
    },
    "productDescriptionSection": {
      "allOf": [
        {
          "$ref": "#/$defs/productSectionBase"
        },
        {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 12000
            },
            "evidenceRefs": {
              "$ref": "#/$defs/evidenceRefs"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "productVariant": {
      "type": "object",
      "required": [
        "productRef",
        "sku",
        "title"
      ],
      "properties": {
        "productRef": {
          "$ref": "#/$defs/opaque"
        },
        "sku": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 64
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "prices": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/price"
          }
        },
        "availability": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    },
    "productVariantsSection": {
      "allOf": [
        {
          "$ref": "#/$defs/productSectionBase"
        },
        {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/productVariant"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "productImage": {
      "type": "object",
      "required": [
        "imageRef",
        "altText"
      ],
      "properties": {
        "imageRef": {
          "$ref": "#/$defs/opaque"
        },
        "altText": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      },
      "additionalProperties": false
    },
    "productImagesSection": {
      "allOf": [
        {
          "$ref": "#/$defs/productSectionBase"
        },
        {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "$ref": "#/$defs/productImage"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "productOffer": {
      "type": "object",
      "required": [
        "productRef",
        "sku",
        "seller",
        "prices",
        "availability",
        "deliveryLabel",
        "evidenceRefs",
        "relation",
        "configurationVerified"
      ],
      "properties": {
        "productRef": {
          "$ref": "#/$defs/opaque"
        },
        "sku": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 64
        },
        "seller": {
          "oneOf": [
            {
              "$ref": "#/$defs/seller"
            },
            {
              "type": "null"
            }
          ]
        },
        "prices": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/price"
          }
        },
        "availability": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ]
        },
        "deliveryLabel": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "relation": {
          "const": "ozon_related_offer"
        },
        "configurationVerified": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "productOffersSection": {
      "allOf": [
        {
          "$ref": "#/$defs/productSectionBase"
        },
        {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/productOffer"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
