{
  "name": "ozon-mcp-server",
  "version": "0.3.2",
  "description": "Local Ozon MCP server for product search, prices, specifications and reviews. Background Chromium, persistent sessions and structured results.",
  "type": "module",
  "bin": {
    "ozon-mcp-server": "src/index.js"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test"
  },
  "keywords": [
    "ozon",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "product-search",
    "shopping-assistant",
    "price-comparison",
    "product-reviews",
    "playwright",
    "chromium",
    "nodejs"
  ],
  "author": "Andrey Sergeyev (fork of eduard256/ozon-mcp-server)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "playwright": "1.60.0",
    "zod": "^3.25.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibelyasov/ozon-mcp-server.git"
  }
}
